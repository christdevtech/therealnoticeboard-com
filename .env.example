NEXT_PUBLIC_SERVER_URL=http://localhost:3000


# Mapbox configuration for property location mapping
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=mapbox key
# Get your access token from https://account.mapbox.com/access-tokens/

# Optional: Mapbox style URL (defaults to streets-v12 if not provided)
NEXT_PUBLIC_MAPBOX_STYLE=mapbox://styles/mapbox/streets-v12
# Custom map style URL


# AI Chat Assistant (Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
# Get from https://aistudio.google.com/apikey
NEXT_PUBLIC_CHAT_ENABLED=true
# Set to false to disable the chat widget